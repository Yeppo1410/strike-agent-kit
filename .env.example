# mock | testnet | mainnet  (mainnet also needs STRIKE_ALLOW_MAINNET=
STRIKE_MODE=

# API wallet (Ed25519). Create it on Strike's API Wallets page, or run
#   python -m strike_agent_kit.signing
# to generate a pair and register the public key there.
STRIKE_API_PUBLIC_KEY=
STRIKE_API_PRIVATE_KEY=

# Only for API wallets created through Builder Connect (they carry your builder code).
# Leave empty for a plain API wallet on your own account.
STRIKE_BUILDER_FEE_BPS=

# Optional
# Use guardrails.mainnet.json for the small mainnet run
STRIKE_GUARDRAILS=
STRIKE_DATA_DIR=
STRIKE_USE_HYPERLIQUID=
